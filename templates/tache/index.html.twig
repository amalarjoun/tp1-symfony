{% extends 'base.html.twig' %}

{% block title %}Liste des tâches{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="mb-4">Ma To-Do List</h1>

    <a href="{{ path('app_tache_ajouter') }}"
       class="btn btn-primary mb-4">
        + Ajouter une tâche
    </a>

    {% if taches is empty %}
        <div class="alert alert-info">
            Aucune tâche pour le moment.
        </div>
    {% else %}
        <table class="table table-bordered table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Titre</th>
                    <th>Description</th>
                    <th>Date de création</th>
                    <th>Statut</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                {% for tache in taches %}
                    <tr>
                        <td>{{ tache.id }}</td>

                        <td>
                            <a href="{{ path('app_tache_detail', {'id': tache.id}) }}"
                            {% if tache.terminee %}
                                style="text-decoration: line-through; color: gray;"
                            {% endif %}>
                                {{ tache.titre }}
                            </a>
                        </td>

                        <td>{{ tache.description ?? 'Aucune description' }}</td>

                        <td>{{ tache.dateCreation|date('d/m/Y à H:i') }}</td>

                        <td>
                            {% if tache.terminee %}
                                <span class="badge bg-success">Terminée</span>
                            {% else %}
                                <span class="badge bg-warning text-dark">En cours</span>
                            {% endif %}
                        </td>

                        <td>
                            {% if not tache.terminee %}
                                <a href="{{ path('app_tache_terminer', {'id': tache.id}) }}"
                                class="btn btn-success btn-sm">
                                    ✓ Terminer
                                </a>
                            {% else %}
                                <span class="text-muted">Déjà terminée</span>
                            {% endif %}
                        </td>
                                            </tr>
                {% endfor %}
            </tbody>
        </table>

        <p class="text-muted">
            Nombre total de tâches : {{ taches|length }}
        </p>
    {% endif %}
</div>
{% endblock %}